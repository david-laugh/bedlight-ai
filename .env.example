# BedLight AI — 환경변수 예시
# 사용: cp .env.example .env  후 값 입력. .env 는 절대 커밋하지 않는다 (.gitignore 처리됨).
# 이 파일에는 변수 이름과 placeholder 만 둔다. 실제 키/비밀번호를 적지 말 것.
#
# 주의: compose.yaml 은 .env 를 (1) 변수 치환용으로 읽고, (2) env_file 로 db-writer 컨테이너에만 주입한다.
#       controller / simulator-web / mock-device 컨테이너에는 Supabase 키가 들어가지 않는다.

# ---------- MQTT ----------
MQTT_HOST=mqtt-broker
MQTT_PORT=1883
MQTT_HOST_PORT=1883
MQTT_TOPIC_PREFIX=bedlight/v1
# 인증 설정(mosquitto.auth.conf) 사용 시에만 채움
MQTT_USERNAME=<mqtt-username>
MQTT_PASSWORD=<mqtt-password>

# ---------- Controller ----------
CONTROLLER_PORT=8000
ROOM_ID=bedroom-01

# ---------- Simulator ----------
SIMULATOR_HOST_PORT=8080

# ---------- Supabase (db-writer 전용, 서버 측 비밀값) ----------
SUPABASE_URL=https://<project-ref>.supabase.co
# secret key (sb_secret_...) 또는 legacy service_role key. RLS 를 우회하므로 브라우저/디바이스/펌웨어에 절대 넣지 말 것.
SUPABASE_SECRET_KEY=<supabase-secret-or-service-role-key>
SUPABASE_EVENTS_TABLE=device_events
DB_WRITER_MAX_RETRIES=5
DB_WRITER_QUEUE_MAX=1000

# ---------- Mock device (compose profile: test) ----------
MOCK_DEVICE_ID=mock-xiao-01
