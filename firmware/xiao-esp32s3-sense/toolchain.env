# BedLight AI firmware toolchain pins (consumed by .github/workflows/firmware-ci.yml)
# ESP32 Arduino Core 는 2.0.x 로 고정한다. (3.x 는 카메라/I2S API 변경으로 Edge Impulse 예제와 호환성 검증 필요)
ESP32_CORE_VERSION=2.0.17
ESP32_BOARD_MANAGER_URL=https://raw.githubusercontent.com/espressif/arduino-esp32/gh-pages/package_esp32_index.json
# XIAO ESP32S3 Sense: OPI PSRAM 활성화 필요 (녹음 버퍼, 카메라 프레임 버퍼, 모델 arena)
# CDCOnBoot=default 는 Core 2.0.17 의 "USB CDC On Boot: Enabled" 항목 (arduino-cli board details 로 확인)
FQBN=esp32:esp32:XIAO_ESP32S3:PSRAM=opi,CDCOnBoot=default
SKETCH_DIR=firmware/xiao-esp32s3-sense/bedlight
# Edge Impulse Arduino 라이브러리 zip 위치 (Edge Impulse Studio > Deployment > Arduino library)
EI_LIBRARY_DIR=firmware/xiao-esp32s3-sense/libraries
